{
  "name": "vigilant-extremity",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.ts",
    "knex": "NODE_OPTIONS='--import tsx' knex --knexfile src/database/knexfile.ts",
    "auto-scaler": "node dist/auto-scaler.js",
    "docker:up": "docker-compose -f docker/docker-compose.yml --env-file .env up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml --env-file .env down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml --env-file .env logs -f",
    "docker:scale": "docker-compose -f docker/docker-compose.yml --env-file .env up -d --scale worker="
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegomaustem/Vigilant-Extremity.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/diegomaustem/Vigilant-Extremity/issues"
  },
  "homepage": "https://github.com/diegomaustem/Vigilant-Extremity#readme",
  "description": "",
  "dependencies": {
    "amqplib": "^2.0.1",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.10",
    "node-cron": "^4.4.1",
    "pg": "^8.21.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/validator": "^13.15.10",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
